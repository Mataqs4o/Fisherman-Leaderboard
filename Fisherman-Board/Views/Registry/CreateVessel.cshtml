@model Fisherman_Board.Models.FishingVessel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@{
    ViewData["Title"] = "Добавяне на лодка";
    var engines = ViewBag.EngineOptions as SelectList;
    var hasEngines = engines?.Any() ?? false;
    var selectedEngineLabel = ViewBag.SelectedEngineLabel?.ToString();
}

<section class="page-header-card">
    <div>
        <span class="eyebrow">Нов запис</span>
        <h1>Добавяне на лодка</h1>
    </div>
    <p>Въведете идентификацията и техническите параметри на нова лодка.</p>
</section>

@if (!string.IsNullOrWhiteSpace(selectedEngineLabel))
{
    <section class="content-card note-card">
        <strong>Избран е двигател: @selectedEngineLabel</strong>
        <span>Двигателят е запазен. Попълнете данните за лодката и натиснете „Запази“, за да се създаде и самият запис за лодката.</span>
    </section>
}

<section class="form-card">
    <form method="post" asp-action="CreateBoat">
        <div asp-validation-summary="All" class="validation-summary text-danger"></div>
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Marking"></label>
                <input asp-for="Marking" class="form-control" />
                <span asp-validation-for="Marking" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="InternationalNumber"></label>
                <input asp-for="InternationalNumber" class="form-control" />
                <span asp-validation-for="InternationalNumber" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="CallSign"></label>
                <input asp-for="CallSign" class="form-control" />
                <span asp-validation-for="CallSign" class="text-danger"></span>
            </div>
            <div class="form-field">
                <div class="field-heading">
                    <label asp-for="EngineId"></label>
                    <a class="btn-inline" asp-action="CreateEngine" asp-route-returnTo="CreateBoat">Добави двигател</a>
                </div>

                @if (hasEngines)
                {
                    <select asp-for="EngineId" asp-items="engines" class="form-select">
                        <option value="">Изберете двигател</option>
                    </select>
                }
                else
                {
                    <div class="engine-helper-card">
                        <strong>Няма въведени двигатели.</strong>
                        <span>Добави двигател и след запазване ще се върнеш тук, за да го избереш за лодката.</span>
                    </div>
                }

                <span asp-validation-for="EngineId" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Length"></label>
                <input asp-for="Length" class="form-control" />
                <span asp-validation-for="Length" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Width"></label>
                <input asp-for="Width" class="form-control" />
                <span asp-validation-for="Width" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Tonnage"></label>
                <input asp-for="Tonnage" class="form-control" />
                <span asp-validation-for="Tonnage" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Draft"></label>
                <input asp-for="Draft" class="form-control" />
                <span asp-validation-for="Draft" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary-soft" @(hasEngines ? null : "disabled")>Запази</button>
            <a class="btn btn-ghost" asp-action="Boats">Отказ</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
