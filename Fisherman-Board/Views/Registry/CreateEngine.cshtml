@model Fisherman_Board.Models.Engine
@{
    ViewData["Title"] = "Добавяне на двигател";
    var returnTo = ViewData["EngineReturnTo"]?.ToString();
    var vesselId = ViewData["EngineReturnVesselId"] is int value ? value : (int?)null;
}

<section class="page-header-card">
    <div>
        <span class="eyebrow">Нов запис</span>
        <h1>Добавяне на двигател</h1>
    </div>
    <p>Въведете параметрите, които ще се използват в регистрите и аналитичните изчисления.</p>
</section>

@if (!string.IsNullOrWhiteSpace(returnTo))
{
    <section class="content-card note-card">
        <strong>След запазване ще се върнеш обратно към лодката.</strong>
        <span>Новият двигател ще бъде избран автоматично, за да можеш веднага да довършиш записа.</span>
    </section>
}

<section class="form-card">
    <form method="post">
        <input type="hidden" name="returnTo" value="@returnTo" />
        <input type="hidden" name="vesselId" value="@vesselId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Type"></label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="FuelType"></label>
                <input asp-for="FuelType" class="form-control" />
                <span asp-validation-for="FuelType" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="PowerKw"></label>
                <input asp-for="PowerKw" class="form-control" />
                <span asp-validation-for="PowerKw" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="AvgFuelPerHour"></label>
                <input asp-for="AvgFuelPerHour" class="form-control" />
                <span asp-validation-for="AvgFuelPerHour" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary-soft">Запази</button>
            @if (string.Equals(returnTo, "CreateBoat", StringComparison.OrdinalIgnoreCase))
            {
                <a class="btn btn-ghost" asp-action="CreateBoat">Назад към лодката</a>
            }
            else if (string.Equals(returnTo, "EditBoat", StringComparison.OrdinalIgnoreCase) && vesselId.HasValue)
            {
                <a class="btn btn-ghost" asp-action="EditBoat" asp-route-id="@vesselId.Value">Назад към лодката</a>
            }
            else
            {
                <a class="btn btn-ghost" asp-action="Engines">Отказ</a>
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
