@using System
@model IEnumerable<Fisherman_Board.ViewModels.CarbonFootprintViewModel>
@{
    ViewData["Title"] = "Въглероден отпечатък";
    var search = ViewData["Search"]?.ToString() ?? string.Empty;
    var sortBy = ViewData["SortBy"]?.ToString() ?? "carbon";
    var sortDir = ViewData["SortDir"]?.ToString() ?? "asc";
    var bestCarbonPerKg = Model.Any() ? Model.Min(item => item.CarbonPerKg) : 0;

    string NextSortDir(string column) =>
        string.Equals(sortBy, column, StringComparison.OrdinalIgnoreCase) && sortDir == "asc"
            ? "desc"
            : "asc";

    string SortIndicator(string column) =>
        string.Equals(sortBy, column, StringComparison.OrdinalIgnoreCase)
            ? (sortDir == "asc" ? " ▲" : " ▼")
            : string.Empty;
}

<section class="page-header-card">
    <div>
        <span class="eyebrow">Справка 4</span>
        <h1>Въглероден отпечатък на улова</h1>
    </div>
    <p>
        Изчисление на разхода на гориво за 1 кг уловена риба, базирано на продължителността на излетите
        и средния разход на двигателя. Корабите с изтекло разрешително не участват в класацията.
    </p>
</section>

<section class="toolbar-card">
    <form class="search-form" method="get">
        <input type="hidden" name="sortBy" value="@sortBy" />
        <input type="hidden" name="sortDir" value="@sortDir" />
        <input type="search" name="search" value="@search" placeholder="Търсене по маркировка" />
        <button type="submit" class="btn btn-primary-soft">Търси</button>
        <a class="btn btn-ghost" asp-action="CarbonFootprint">Изчисти</a>
    </form>
    <a class="btn btn-ghost" asp-action="Index">Назад към справките</a>
</section>

@if (!Model.Any())
{
    <section class="content-card empty-state-card">
        <h2>Няма резултати</h2>
        <p>Няма достатъчно валидни данни за изчисляване на въглероден отпечатък.</p>
    </section>
}
else
{
    <section class="table-card">
        <table class="table table-app">
            <thead>
                <tr>
                    <th><a asp-action="CarbonFootprint" asp-route-search="@search" asp-route-sortBy="vessel" asp-route-sortDir='@NextSortDir("vessel")'>Кораб@SortIndicator("vessel")</a></th>
                    <th><a asp-action="CarbonFootprint" asp-route-search="@search" asp-route-sortBy="catch" asp-route-sortDir='@NextSortDir("catch")'>Общ улов@SortIndicator("catch")</a></th>
                    <th><a asp-action="CarbonFootprint" asp-route-search="@search" asp-route-sortBy="fuel" asp-route-sortDir='@NextSortDir("fuel")'>Общо гориво@SortIndicator("fuel")</a></th>
                    <th><a asp-action="CarbonFootprint" asp-route-search="@search" asp-route-sortBy="carbon" asp-route-sortDir='@NextSortDir("carbon")'>Литра на 1 кг@SortIndicator("carbon")</a></th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.VesselMarking</td>
                        <td>@item.TotalCatchKg.ToString("F2") кг</td>
                        <td>@item.TotalFuel.ToString("F2") л</td>
                        <td>@item.CarbonPerKg.ToString("F2") л/кг</td>
                        <td>
                            @if (Math.Abs(item.CarbonPerKg - bestCarbonPerKg) < 0.0001)
                            {
                                <span class="table-pill table-pill-success">Най-ефективен</span>
                            }
                            else
                            {
                                <span class="table-pill">В класацията</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}